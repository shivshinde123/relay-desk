PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=support_desk
DB_SSL=false

# Use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Optional. Leave empty to use the built-in rule-based classifier.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated origins allowed if the frontend is hosted separately (e.g. Netlify/Vercel)
CORS_ORIGIN=http://localhost:3000
